# The one address everything is served from. https://your.domain gets automatic
# HTTPS from Let's Encrypt; http://localhost is a plain-HTTP local try-out.
SITE_URL=https://your.domain

# Any long random string; signs sessions and tokens. Change it once, never again.
SECRET=

# Empty on first start. Step 5 of the README fills it.
PASSWORD_SECRET=

# Your user and group ids (id -u, id -g), so files in ./content belong to you.
UID_GID=1000:1000

# Only change these if 80/443 are taken on the host.
HTTP_PORT=80
HTTPS_PORT=443
