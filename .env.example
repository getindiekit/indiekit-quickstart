# The one address everything is served from. https://your.domain gets automatic
# HTTPS from Let's Encrypt; http://quickstart.localhost is a plain-HTTP local
# try-out (see the README).
SITE_URL=https://your.domain

# The host part of SITE_URL, on its own. Sign-in makes the server contact its
# own address; this maps that name to this machine from inside the container.
# Defaults to quickstart.localhost, the local try-out name.
SITE_HOST=your.domain

# Any long random string; signs sessions and tokens. Change it once, never again.
SECRET=

# Empty on first start. ./bootstrap fills it.
PASSWORD_SECRET=

# Your user and group ids (id -u, id -g), so files in ./content belong to you.
UID_GID=1000:1000

# DEMO=1 boots a showcase: the theme's sample posts are copied into ./content
# (only where no such file exists yet), the site builds with the demo identity
# and sample webmentions, and your site.json is not read. Set it back to 0 and
# the samples are hidden again; delete content/*/fixture-* to remove them.
DEMO=0

# Only change these if 80/443 are taken on the host.
HTTP_PORT=80
HTTPS_PORT=443
